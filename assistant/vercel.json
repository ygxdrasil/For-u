{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/stamp-build.mjs && node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "vendor/**"
    },
    "api/agent.js": {
      "maxDuration": 60,
      "includeFiles": "vendor/**"
    },
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "vendor/**"
    },
    "api/sweep.js": {
      "maxDuration": 60,
      "includeFiles": "vendor/**"
    },
    "api/workflow.js": {
      "maxDuration": 30,
      "includeFiles": "vendor/**"
    },
    "api/dashboard.js": {
      "maxDuration": 30,
      "includeFiles": "vendor/**"
    },
    "api/health.js": {
      "maxDuration": 15,
      "includeFiles": "vendor/catalog.json"
    },
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/clientlog.js": {
      "maxDuration": 10
    },
    "api/settings.js": {
      "maxDuration": 30
    },
    "api/tokens.js": {
      "maxDuration": 15
    },
    "api/findings.js": {
      "maxDuration": 15
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/n8n-workflow-ai-assistant-vmciql": false
    }
  }
}
