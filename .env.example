# GEMINI_API_KEY: Required. Grace cannot think without it.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GRACE_SECRET: Optional but recommended. Encrypts Grace's memory at rest
# (conversations, and everything she has learned about you) with AES-256-GCM.
# Use a long random string. If you lose it, existing memory cannot be read back.
# GRACE_SECRET=""

# GRACE_MODEL: Which Gemini model Grace runs on. Flash is the free-tier default.
# GRACE_MODEL="gemini-2.5-flash"

# GRACE_DATA_DIR: Where memory is stored on disk. Defaults to ./.grace
# GRACE_DATA_DIR=""

# GRACE_LEARN: Set to false to stop Grace building a profile of you.
# GRACE_LEARN="true"

# PORT: Port for the production server (npm start). Defaults to 3001.
# PORT="3001"

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Gmail and Google Calendar (optional) ---
# See GOOGLE-SETUP.md. Without these, mail and diary simply stay disconnected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may connect. Stops anyone else who finds the link
# from attaching their own mailbox to your Grace.
GRACE_OWNER_EMAIL=
# Only needed on a custom domain. Must match Google's console exactly.
# GOOGLE_REDIRECT_URI=https://your-domain/api/google/callback
