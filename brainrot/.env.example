# Copy to brainrot/.env. Everything here is optional — with none of it set the
# pipeline still runs, using built-in scripts and placeholder visuals.

# Scripts. Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Images, provider 1. Free tier ~1.5 pollen/week, roughly 15k images.
# Sign up at https://auth.pollinations.ai
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

# Images, provider 2. Free tier 10,000 neurons/day.
# https://dash.cloudflare.com -> AI -> Workers AI, plus an API token with
# the "Workers AI" read permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Pin a provider instead of trying them in order: pollinations | cloudflare | gemini
# gemini is opt-in only — its image models are not reliably free tier.
BRAINROT_IMAGES=

# Optional: --animate hf, best-effort image-to-video on Hugging Face's free tier.
HF_TOKEN=
HF_VIDEO_MODEL=Lightricks/LTX-Video
