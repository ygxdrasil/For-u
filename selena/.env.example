# Selena's environment. Every one of these is optional — she deploys and runs
# with none of them set, and says on screen exactly what she cannot do without
# each. Copy to .env for local use, or set them in the Vercel dashboard.

# Reading the web. Without it Selena runs, shows her state and answers from the
# record, but produces no findings — she will not invent one she cannot source.
GEMINI_API_KEY=

# Durable storage (Neon, free tier). Without it she keeps state in memory: it
# survives within a warm instance and is lost on a cold start, so watches
# cannot remember what they already reported.
DATABASE_URL=

# Auth for every route except /api/health. WITHOUT THIS THE API IS OPEN and
# answers anyone who finds the URL. The HUD shows a red banner until it is set.
SELENA_TOKEN=

# Etsy Open API keystring, as "keystring:shared_secret". The strongest evidence
# source: marketplace search plus listing and shop reviews, none of which needs
# an OAuth scope. Register a Personal App at etsy.com/developers/register.
ETSY_API_KEY=

# Where handoff packets are POSTed when you press "Send to Jason". Without it a
# packet is prepared and recorded but not sent anywhere.
JASON_ENDPOINT=
JASON_TOKEN=

# Hard monthly ceiling in USD, checked before each request rather than after.
# Default 10.
MONTHLY_USD_CAP=10
