{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/stamp-build.mjs && node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "functions": {
    "api/research.js": {
      "maxDuration": 60
    },
    "api/command.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/watches.js": {
      "maxDuration": 60
    },
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/findings.js": {
      "maxDuration": 60
    },
    "api/handoff.js": {
      "maxDuration": 30
    },
    "api/auth.js": {
      "maxDuration": 20
    },
    "api/dashboard.js": {
      "maxDuration": 20
    },
    "api/health.js": {
      "maxDuration": 15
    },
    "api/peers.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
